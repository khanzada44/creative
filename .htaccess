# ===================== Creative Converge — .htaccess =====================
# Live (creativeconverge.com) aur localhost (/mockups/) — dono par chalti hai

Options -Indexes
DirectoryIndex index.php index.html

RewriteEngine On

# ---------- 0. Site kis folder mein hai — khud pata karo ----------
# Live par BASE = "/"   |   localhost par BASE = "/mockups/"
RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
RewriteRule ^(.*)$ - [E=BASE:%1]

# ---------- 1. HTTPS + bina "www" (sirf live par, localhost par nahi) ----------
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# ---------- 2. /includes/ ki files seedha browser se na khulein ----------
RewriteRule ^includes/ - [F,L]

# ---------- 3. Purane service URLs -> naya saaf URL (301) ----------
# .../services/service-detail.php?slug=laravel  -> .../services/service-detail/laravel
# .../services/service-detail?slug=laravel      -> .../services/service-detail/laravel
RewriteCond %{THE_REQUEST} \s[^\s?]*/services/service-detail(?:\.php)?\?slug=([a-zA-Z0-9-]+)[\s&] [NC]
RewriteRule ^services/service-detail(?:\.php)?$ %{ENV:BASE}services/service-detail/%1? [R=301,L,NE]

# .../service-detail/laravel (purana short URL) -> .../services/service-detail/laravel
RewriteRule ^service-detail/([a-zA-Z0-9-]+)/?$ %{ENV:BASE}services/service-detail/$1 [R=301,L]

# ---------- 4. Saaf service URL andar se service-detail.php chalaye ----------
RewriteRule ^services/service-detail/([a-zA-Z0-9-]+)/?$ services/service-detail.php?slug=$1 [L,QSA]

# ---------- 5. index.php kahin bhi ho -> folder ----------
# /index.php -> /      /about/index.php -> /about/      /about/index -> /about/
# (Form POST ko redirect nahi — warna form ka data gum ho jata hai)
RewriteCond %{REQUEST_METHOD} !=POST
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index(?:\.php)?[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# ---------- 6. .php wale URL -> bina .php (301) ----------
# (Form POST ko redirect nahi — /email.php par bheja gaya data redirect mein gum ho jata tha)
RewriteCond %{REQUEST_METHOD} !=POST
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# ---------- 7. Bina .php wala URL andar se .php file chalaye ----------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
